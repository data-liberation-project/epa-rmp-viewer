  "_exec_summary": [
    {
      "ESSeqNum": 0,
      "FacilityID": 1000093536,
      "SummaryText": "As part of the fuel blending operation, Gage Products Company has a 13,000 gallon above ground storage tank (AST) used to store isopentane (Tank 209) and a 16,000 gallon AST (Tank 10) storing n-pentane. These tanks have been registered with the State of Michigan Licensing and Regulatory Affairs (LARA.) The ASTs are in separate diked areas and both include an emergency vent, a conservation vent, and nitrogen blanketing. In the event of a fire, the fill/discharge valves would shut closed when the fused compressed air line is melted."
    }
  ]
